rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.email is string &&
        data.email.size() <= 150 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('rollNumber' in data) || (data.rollNumber is string && data.rollNumber.size() <= 30)) &&
        (!('branch' in data) || (data.branch is string && data.branch.size() <= 80)) &&
        (!('section' in data) || (data.section is string && data.section.size() <= 20)) &&
        (!('courseCode' in data) || (data.courseCode is string && data.courseCode.size() <= 50)) &&
        (!('courseName' in data) || (data.courseName is string && data.courseName.size() <= 120)) &&
        (!('theme' in data) || (data.theme is string && data.theme.size() <= 30)) &&
        (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 30));
    }

    // Academic document validation
    function isValidAcademicDocument(data, userId, docId) {
      return data.id == docId &&
        data.userId == userId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.toolType in ['aat_ppt', 'aat_assignment', 'project_report', 'case_study'] &&
        (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 150)) &&
        (!('courseCode' in data) || (data.courseCode is string && data.courseCode.size() <= 50)) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users can only access their own profile by direct ID
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      match /documents/{documentId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(documentId) && isValidAcademicDocument(incoming(), userId, documentId);
        allow update: if isOwner(userId) && isValidAcademicDocument(incoming(), userId, documentId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
